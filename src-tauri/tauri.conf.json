{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShotSynq",
  "version": "0.9.0",
  "identifier": "com.rorymarshall.shotsynq",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ShotSynq",
        "width": 1440,
        "height": 860,
        "minWidth": 1280,
        "minHeight": 720,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "© 2026 Rory Marshall",
    "publisher": "Rory Marshall",
    "shortDescription": "Sync multicam video and audio into an editable timeline",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "binaries/FFMPEG-LICENSE.txt": "FFMPEG-LICENSE.txt",
      "binaries/FFMPEG-VERSION.txt": "FFMPEG-VERSION.txt"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
